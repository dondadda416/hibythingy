# ── HiBy Hub environment ────────────────────────────────────────────────────
# Copy this file to `.env` (which is gitignored) and fill in real values.
# The server reads these via `dotenv` at boot — see config.js.

# Anthropic API key for AI album identification.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Last.fm API key (optional — enables scrobble stats).
# Get one at https://www.last.fm/api/account/create
LASTFM_API_KEY=your-lastfm-key-here

# Last.fm username (optional).
LASTFM_USERNAME=your-lastfm-username

# Contact email used in MusicBrainz User-Agent (recommended by their TOS).
# Use any address that can receive abuse reports — does NOT have to be personal.
HIBYHUB_CONTACT_EMAIL=admin@example.com

# Server bind port (default: 3847).
# PORT=3847

# Optional: per-day AI spend cap in USD. Default 5.
# DAILY_AI_BUDGET_USD=5

# Optional: override the music folder name on the HiBy SD card. Default tries
# Music, MUSIC, music, Music Library, My Music, MyMusic, then falls back to
# the volume root. Set this if your DAP uses a different folder name.
# DEVICE_MUSIC_FOLDER=My Music

# ── Remote access (Cloudflare Tunnel / Tailscale) ──────────────────────────
# See DEPLOY.md for the full setup. None of these are needed for local-only
# use; they only matter when you expose Hub via a reverse proxy.

# Trust X-Forwarded-* headers from a localhost reverse proxy. Required for
# accurate client IPs in the rate-limiter and activity log.
# HUB_TRUST_PROXY=true

# Comma-separated full origins allowed by CORS. Add your tunnel hostname.
# ALLOWED_ORIGINS=https://hiby.example.com

# Optional HTTP Basic auth. Defence-in-depth alongside Cloudflare Access.
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASS=a-long-random-string
