# ── HiBy Hub environment ────────────────────────────────────────────────────
# deploy/setup.sh writes the server's .env for you. Copy this file to `.env`
# only for local development. `.env` is gitignored — never commit it.

# ── Folders ─────────────────────────────────────────────────────────────────
HUB_INBOX_PATH=/srv/hiby/inbox
HUB_LIBRARY_PATH=/srv/hiby/library
HUB_DATA_DIR=/srv/hiby/data
# HUB_INBOX_DAYS=30
# HUB_LIBRARY_SCAN_MINUTES=15

# ── Cloudflare R2 (the library bucket) ──────────────────────────────────────
# Used to give the R4 direct download links. Leave blank to stream through Hub.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hiby-library
R2_LIBRARY_PREFIX=library
# R2_LINK_TTL_SECONDS=21600

# ── Wheelhouse (the R4 app) ─────────────────────────────────────────────────
# Long random string; enter the same value in Wheelhouse. Sync is off if blank.
WHEELHOUSE_TOKEN=
# WHEELHOUSE_ONLINE_MINUTES=10
# Cloudflare Access service token for the R4 (shown on /connect as a setup code):
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# HUB_PUBLIC_URL=https://hiby.example.com

# ── AI identification / Last.fm (optional) ──────────────────────────────────
ANTHROPIC_API_KEY=
LASTFM_API_KEY=
LASTFM_USERNAME=
HIBYHUB_CONTACT_EMAIL=admin@example.com
# DAILY_AI_BUDGET_USD=5

# ── Server ──────────────────────────────────────────────────────────────────
HUB_HOST=127.0.0.1
PORT=3847
# Behind cloudflared on the same machine:
HUB_TRUST_PROXY=true
ALLOWED_ORIGINS=https://hiby.example.com
# Optional extra password in front of everything except /api/wheelhouse:
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=
